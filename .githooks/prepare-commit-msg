#!/bin/sh
# Adds the DCO "Signed-off-by: Name <email>" trailer to every commit message
# that does not already carry one for this author, so contributors never have
# to remember `git commit -s`. Activated per clone by `task repo:setup`
# (core.hooksPath = .githooks via the tracked .gitconfig).
#
# Arguments from git: <message file> [<source> [<sha>]]. Runs for every
# commit source (message, template, merge, squash, commit) - a merge or amend
# without a sign-off is still a commit you are certifying.
msg_file="$1"

# The committer, as `git commit -s` signs: it honours GIT_COMMITTER_* (set by
# the git Feature's identity, or for a rebase or cherry-pick), where reading
# user.name and user.email would sign as whoever the config names instead.
ident="$(git var GIT_COMMITTER_IDENT 2>/dev/null)" || exit 0 # no identity: git reports it
ident="${ident% * *}" # drop the timestamp and zone

# addIfDifferent: keep existing sign-offs from other people, add ours once.
git interpret-trailers --in-place --if-exists addIfDifferent \
	--trailer "Signed-off-by: $ident" "$msg_file"
