#!/bin/sh
# Regenerates /usr/local/share/go-task/features.yml: a Taskfile whose only job
# is to include every Feature-contributed Taskfile found in
# /usr/local/share/go-task/includes.d/<id>.yml, namespaced by <id>.
#
# Installed by the go-task Feature and run (as root, at image build time) by
# it and by every Feature that drops a file into includes.d, so the result is
# the same whatever order the Features install in. A root Taskfile picks all
# of them up with a single include:
#
#   includes:
#     features:
#       taskfile: /usr/local/share/go-task/features.yml
#       optional: true   # absent outside the devcontainer
#       flatten: true    # expose as <id>:<task>, not features:<id>:<task>
set -eu

dir=/usr/local/share/go-task
out="$dir/features.yml"
mkdir -p "$dir/includes.d"
tmp="$(mktemp)"

{
  echo "# Generated by task-features-registry (go-task Feature). Do not edit:"
  echo "# it is rebuilt from $dir/includes.d/*.yml whenever a Feature installs."
  echo "version: '3'"
  if ls "$dir"/includes.d/*.yml >/dev/null 2>&1; then
    echo "includes:"
    for f in "$dir"/includes.d/*.yml; do
      id="$(basename "$f" .yml)"
      echo "  $id:"
      echo "    taskfile: $f"
    done
  else
    echo "includes: {}"
  fi
} > "$tmp"

install -m 0644 "$tmp" "$out"
rm -f "$tmp"
echo "task-features-registry: $(ls "$dir"/includes.d/*.yml 2>/dev/null | wc -l | tr -d ' ') Feature Taskfile(s) registered in $out"
