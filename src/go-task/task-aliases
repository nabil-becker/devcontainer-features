#!/usr/bin/env bash
# task-aliases: team task aliases for the go-task Feature (docs/proposals/task-aliases.md).
#
#   task-aliases generate [--team FILE] [--out FILE]
#
# Reads the team file (aliases: name -> an existing task, optional desc and fixed vars), checks every
# alias against `task --list-all --json` of the root Taskfile, and writes one wrapper task per
# accepted alias into the generated file that features.yml includes (flattened), so each alias shows
# in `task --list`. Prints the report (alias, target, layer, status, note).
#
# Never fatal: always exits 0 (2 only for a usage error), and always leaves a valid generated file
# (`tasks: {}` at worst). The file is data, never code: no command field, vars are plain scalars,
# every emitted value is a single-quoted YAML scalar, names and targets match a fixed pattern, and
# nothing is evaluated or sourced.
#
# Environment: TASK_ALIASES_YQ (the yq to use), TASK_ALIASES_TASK (the task binary, default `task`),
# GO_TASK_TEAM_ALIASES_FILE (the team file; default from the Feature's option).
set -uo pipefail

share="${GO_TASK_SHARE:-/usr/local/share/go-task}" # overridable for tests
state="${GO_TASK_STATE:-/var/lib/devcontainer-features/go-task}"
default_out="$state/aliases.yml"
name_re='^[a-z][a-z0-9_-]*(:[a-z][a-z0-9_-]*)*$'
var_re='^[A-Za-z_][A-Za-z0-9_]*$'

usage() { echo "usage: task-aliases generate [--team FILE] [--out FILE]" >&2; exit 2; }

cmd="${1:-}"
[ "$cmd" = generate ] || usage
shift
team="${GO_TASK_TEAM_ALIASES_FILE:-}"
out="$default_out"
while [ $# -gt 0 ]; do
  case "$1" in
    --team) team="${2:-}"; shift 2 || usage ;;
    --out) out="${2:-}"; shift 2 || usage ;;
    *) usage ;;
  esac
done
if [ -z "$team" ] && [ -r "$share/aliases.conf" ]; then
  team="$(sed -n 's/^team=//p' "$share/aliases.conf" | head -n1)"
fi
team="${team:-.devcontainer/task-aliases.yml}"

# --- the yq to use: the private copy this Feature installs, else one on PATH
yq_bin="${TASK_ALIASES_YQ:-}"
if [ -z "$yq_bin" ]; then
  if [ -x "$share/yq" ]; then yq_bin="$share/yq"; else yq_bin="$(command -v yq || true)"; fi
fi
task_bin="${TASK_ALIASES_TASK:-task}"

# --- the generated file: always valid, written atomically
header() {
  echo "# Generated by task-aliases (go-task Feature). Do not edit: regenerate with"
  echo "# \`task go-task:aliases\`. Source: the team aliases file."
  echo "version: '3'"
}
write_out() { # <body file>: install it over \$out, or say why not
  local d tmp
  d="$(dirname "$out")"
  mkdir -p "$d" 2>/dev/null || true
  tmp="$(mktemp "$d/.aliases.XXXXXX" 2>/dev/null)" || { echo "task-aliases: cannot write $out" >&2; return 1; }
  if cat "$1" > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$out"; then return 0; fi
  rm -f "$tmp"
  echo "task-aliases: cannot write $out" >&2
  return 1
}
body="$(mktemp)"
trap 'rm -f "$body"' EXIT
{ header; echo "tasks: {}"; } > "$body"
write_out "$body" || true   # first an empty file: a stale one cannot break the listing below

rows=()
add_row() { rows+=("$1|${2//[[:cntrl:] ]/?}|$3|$4"); } # alias|target|status|note
q() { local s="${1//\'/\'\'}"; printf "'%s'" "$s"; } # a single-quoted YAML scalar
finish() {
  local ok=0 r
  printf '%-24s %-28s %-8s %s\n' ALIAS TARGET STATUS NOTE
  for r in "${rows[@]:-}"; do
    [ -n "$r" ] || continue
    IFS='|' read -r a t s n <<<"$r"
    [ "$s" = ok ] && ok=$((ok + 1))
    printf '%-24s %-28s %-8s %s\n' "$a" "$t" "$s" "$n"
  done
  echo "aliases: $ok ok, $(( ${#rows[@]} - ok )) not generated (generated file: $out)"
  exit 0
}

if [ -z "$yq_bin" ] || ! "$yq_bin" --version >/dev/null 2>&1; then
  echo "task-aliases: yq not found (install the go-task Feature with taskAliases: true); no aliases generated" >&2
  finish
fi
y() { "$yq_bin" "$@"; }

# --- the root Taskfile's tasks (what an alias may not shadow, what it may call)
listing="$(mktemp)"
trap 'rm -f "$body" "$listing"' EXIT
if ! "$task_bin" --list-all --json > "$listing" 2>/dev/null || ! y -p=json -oy -e '.tasks' "$listing" >/dev/null 2>&1; then
  echo "task-aliases: cannot read the tasks of the root Taskfile (task --list-all --json failed); no aliases generated" >&2
  finish
fi
real_tasks="$(y -p=json -oy -r '.tasks[].name' "$listing")"
real_aliases="$(y -p=json -oy -r '.tasks[].aliases[]' "$listing")"
has_line() { printf '%s\n' "$1" | grep -Fxq -- "$2"; }

# the team file is relative to the root Taskfile's folder
if [ "${team#/}" = "$team" ]; then
  root_file="$(y -p=json -oy -r '.location' "$listing" 2>/dev/null || true)"
  [ -n "$root_file" ] && [ "$root_file" != null ] && team="$(dirname "$root_file")/$team"
fi
if [ ! -f "$team" ]; then
  echo "task-aliases: no team file at $team: no aliases"
  finish
fi
if ! y -e '.' "$team" >/dev/null 2>&1; then
  add_row "(file)" "$team" invalid "unreadable YAML"
  finish
fi
if [ "$(y -r 'tag' "$team")" != '!!map' ]; then
  add_row "(file)" "$team" invalid "top level is not a map"
  finish
fi
extra="$(y -r 'keys | .[]' "$team" | grep -vFx aliases || true)"
if [ -n "$extra" ]; then
  add_row "(file)" "$team" invalid "unknown top-level key(s): $(echo "$extra" | tr '\n' ' ')"
  finish
fi
if [ "$(y -r '.aliases | tag' "$team")" = '!!null' ]; then finish; fi
if [ "$(y -r '.aliases | tag' "$team")" != '!!map' ]; then
  add_row "(file)" "$team" invalid "aliases is not a map"
  finish
fi

plain() { # <value>: single line, no control characters, no template
  case "$1" in *'{{'*) return 1 ;; esac
  [[ "$1" != *[[:cntrl:]]* ]]
}

: > "$body"
count="$(y -r '.aliases | length' "$team")"
alias_names="$(y -r '.aliases | keys | .[]' "$team")"
seen=$'\n'
i=0
while [ "$i" -lt "$count" ]; do
  e=".aliases | to_entries | .[$i]"
  i=$((i + 1))
  name="$(y -r "$e | .key" "$team")"
  kind="$(y -r "$e | .value | tag" "$team")"
  target='' desc='' vars=()
  if ! [[ "$name" =~ $name_re ]]; then
    add_row "${name//[[:cntrl:]]/?}" - invalid "name must match $name_re"; continue
  fi
  case "$seen" in *$'\n'"$name"$'\n'*) add_row "$name" - invalid "defined twice"; continue ;; esac
  seen="$seen$name"$'\n'
  case "$kind" in
    '!!str') target="$(y -r "$e | .value" "$team")" ;;
    '!!map')
      bad="$(y -r "$e | .value | keys | .[]" "$team" | grep -vxE 'task|desc|vars' | head -n1 || true)"
      if [ -n "$bad" ]; then add_row "$name" - invalid "unknown key '${bad//[[:cntrl:]]/?}' (only task, desc, vars)"; continue; fi
      if [ "$(y -r "$e | .value | .task | tag" "$team")" != '!!str' ]; then
        add_row "$name" - invalid "task is required (a task name)"; continue
      fi
      target="$(y -r "$e | .value | .task" "$team")"
      dt="$(y -r "$e | .value | .desc | tag" "$team")"
      if [ "$dt" = '!!str' ]; then
        desc="$(y -r "$e | .value | .desc" "$team")"
        if ! plain "$desc"; then add_row "$name" "$target" invalid "desc must be one line without {{"; continue; fi
      elif [ "$dt" != '!!null' ]; then
        add_row "$name" "$target" invalid "desc must be a string"; continue
      fi
      vt="$(y -r "$e | .value | .vars | tag" "$team")"
      if [ "$vt" = '!!map' ]; then
        n="$(y -r "$e | .value | .vars | length" "$team")"
        j=0 verr=
        while [ "$j" -lt "$n" ]; do
          ve="$e | .value | .vars | to_entries | .[$j]"
          j=$((j + 1))
          vk="$(y -r "$ve | .key" "$team")"
          vtag="$(y -r "$ve | .value | tag" "$team")"
          vv="$(y -r "$ve | .value" "$team")"
          if ! [[ "$vk" =~ $var_re ]]; then verr="variable name '${vk//[[:cntrl:]]/?}' is not an identifier"; break; fi
          case "$vtag" in !!str | !!int | !!float | !!bool) ;; *) verr="variable $vk must be a plain string, number or boolean (no sh:, ref:, lists)"; break ;; esac
          if ! plain "$vv"; then verr="variable $vk must be one line without {{ (templates are code)"; break; fi
          vars+=("$vk=$vv")
        done
        if [ -n "$verr" ]; then add_row "$name" "$target" invalid "$verr"; continue; fi
      elif [ "$vt" != '!!null' ]; then
        add_row "$name" "$target" invalid "vars must be a map"; continue
      fi ;;
    *) add_row "$name" - invalid "must be a task name or a map with task"; continue ;;
  esac
  if ! [[ "$target" =~ $name_re ]]; then add_row "$name" "${target//[[:cntrl:]]/?}" invalid "target is not a task name"; continue; fi
  if has_line "$real_tasks" "$name" || has_line "$real_aliases" "$name"; then
    add_row "$name" "$target" shadows "a real task or task alias has this name"; continue
  fi
  if ! has_line "$real_tasks" "$target"; then
    if has_line "$alias_names" "$target"; then
      add_row "$name" "$target" invalid "points at another alias: aliases point at real tasks only"
    else
      add_row "$name" "$target" broken "no such task"
    fi
    continue
  fi
  [ -n "$desc" ] || desc="alias for $target"
  {
    echo "  $(q "$name"):"
    echo "    desc: $(q "$desc")"
    echo "    dir: '{{.USER_WORKING_DIR}}'"
    echo "    cmds:"
    echo "      - task: $(q "$target")"
    if [ "${#vars[@]}" -gt 0 ]; then
      printf '        vars: {'
      sep=' '
      for v in "${vars[@]}"; do printf '%s%s: %s' "$sep" "${v%%=*}" "$(q "${v#*=}")"; sep=', '; done
      echo ' }'
    fi
  } >> "$body"
  add_row "$name" "$target" ok ""
done

if [ -s "$body" ]; then
  { header; echo "tasks:"; cat "$body"; } > "$body.new" && mv -f "$body.new" "$body"
  write_out "$body" || true
fi
finish
