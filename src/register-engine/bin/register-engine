#!/usr/bin/env -S python3 -I
"""The register-engine command; the library sits in ../lib/register-engine beside this file's folder,
with this Feature's own copy of sign-packet's library in it. Isolated (-I): no PYTHONPATH and no user site, so nothing
in the caller's environment can stand in for the code that checks entries or runs the guards."""
import sys
from pathlib import Path

lib = Path(__file__).resolve().parents[1] / "lib"
sys.path[:0] = [str(lib / "register-engine")]
from registerengine.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
