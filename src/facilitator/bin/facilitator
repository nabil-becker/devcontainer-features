#!/usr/bin/env -S python3 -I
"""The facilitator command. Installed, its first line names the Feature's venv (slim-bindings is there) and
the library is /usr/local/lib/facilitator; in the source tree the library is the folder above this one.
Isolated (-I): nothing in the caller's environment or working folder stands in for the code that signs,
checks and routes, and register-engine reads its types folder only from an isolated process."""
import sys
from pathlib import Path

here = Path(__file__).resolve().parents[1]
lib = here if (here / "facilitator" / "__init__.py").is_file() else here / "lib" / "facilitator"
sys.path[:0] = [str(lib)]
from facilitator.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
