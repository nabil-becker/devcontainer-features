# Task's remote-include cache and checksums
.task/
*.ignore

# This repo's own devcontainer references the Features by local path; staged
# copies of src/<id> by `task features:stage` (initializeCommand).
.devcontainer/features/

# Python bytecode from the devhost unit tests
__pycache__/
.devhost/redact-names.txt

# Local environment files (secrets); a .env.example stays trackable.
.env
.env.*
!.env.example

# The generated homepage and the URL it was published at (devhost-site, publish-site skill)
.devhost/site/
.devhost/site-url
