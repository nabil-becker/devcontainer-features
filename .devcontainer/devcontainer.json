{
  "name": "devcontainer-features",
  // Debian 13 (trixie) pinned by name: python3 (the devhost unit tests) is the
  // distro's 3.13. Lint's other tools are pinned in "features" below; CI builds
  // .devcontainer/ci/devcontainer.json, which `task lint:toolchain` keeps
  // identical to this file in everything listed there.
  "image": "mcr.microsoft.com/devcontainers/base:2-trixie",
  // The devhost of this collection: everything `task lint`, `task test` and
  // `task docs` need, plus the collection's own Features so the host
  // session (Claude Code) works here the way every consuming repo does.
  "features": {
    // The tool versions `task lint` runs with, pinned here and nowhere else (CI
    // builds the same entries from .devcontainer/ci/devcontainer.json; bump a
    // version in both, `task lint:toolchain` fails when they differ). Pester
    // (test:bootstrap) and PSScriptAnalyzer are installed in the image, since a
    // module installed by hand into the user's modules is gone after a rebuild.
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "7.6.7",
      "modules": "Pester==6.2.0,PSScriptAnalyzer==1.25.0"
    },
    // docker-in-docker rather than -outside-of-: `devcontainer features test`
    // bind-mounts paths from inside this container into the test containers,
    // which only a daemon sharing this filesystem can resolve. moby:false
    // because the base image is Debian 13 (no moby packages). On wslc (no
    // --privileged) the daemon does not start; the post-create report says so.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/shellcheck:1": {
      "version": "0.11.0"
    },
    "ghcr.io/devcontainers-extra/features/yamllint:2": {
      "version": "1.38.0"
    },
    // The collection's own Features by local path: `task features:stage`
    // copies src/<id> and local-features/<id> into .devcontainer/features/ (gitignored) before every
    // start (initializeCommand), so unreleased changes are what runs here.
    "./features/common": {},
    "./features/go-task": { "version": "3.54.0" },
    "./features/devcontainer-cli": {},
    "./features/git": {
      "hooksPath": ".githooks",
      // Agents (any process Claude Code starts carries CLAUDECODE) commit as
      // the bot; the Operator's own terminal keeps their identity (ADR 0002).
      "commitName": "devhost agent",
      "commitEmail": "devhost-agent@noreply.invalid",
      "commitWhenEnv": "CLAUDECODE"
    },
    "./features/gh": {},
    "./features/claude-code": {},
    // The agent list is .devcontainer/agents.yml: `task agents -- host` inside,
    // `task devcontainer:agent -- host` from the workstation. Sessions show the
    // machine and the handle ("desk host"), so the host sessions of several
    // machines can be told apart.
    "./features/agents": {
      "sessionName": "{machine} {handle}"
    },
    "./features/devhost": {},
    // One folder of the Operator's own personal OneDrive (remotePath), mounted
    // live at /mnt/cloud-folder, never the whole drive (`task cloud-folder:login`
    // once, with the personal Microsoft account). mount needs FUSE, granted per
    // machine: DCF_HOST_FUSE=1 in .devcontainer/.env on the workstation
    // (ADR 0031).
    "./features/cloud-folder": {
      "mode": "mount",
      "remoteType": "onedrive",
      "driveType": "personal",
      "remotePath": "Agent Artifacts/devcontainer-features"
    }
  },
  // FUSE on request, per machine (ADR 0031): with DCF_HOST_FUSE=1 in
  // .devcontainer/.env the launcher fills these three slots; otherwise each
  // falls back to a harmless label.
  "runArgs": [
    "${localEnv:DCF_HOST_FUSE_DEVICE:--label=dcf.fuse.device=off}",
    "${localEnv:DCF_HOST_FUSE_CAP:--label=dcf.fuse.cap=off}",
    "${localEnv:DCF_HOST_FUSE_SECURITY:--label=dcf.fuse.security=off}"
  ],
  // Host side, before every start: stage the Features, and make sure
  // ~/.git-dirs exists so the mount below never fails.
  "initializeCommand": {
    "features": ["task", "features:stage"],
    "git-dirs": ["task", "devcontainer:homes", "NAME=devcontainer-features"]
  },
  // The checkout's .git is a pointer file naming a git dir under ~/.git-dirs
  // (outside OneDrive). The whole folder is mounted, the same line in every
  // repository; the git Feature's wrapper maps the pointer onto it (ADR 0020).
  // Every git dir under ~/.git-dirs is visible here, accepted 2026-10-21.
  "mounts": [
    "source=${localEnv:USERPROFILE}/.git-dirs,target=/git-dirs,type=bind"
  ],
  "containerEnv": {
    // The handle on ledger entries and the cost report (committed, so never a
    // name): set DEVHOST_ENGINEER on the workstation to tell engineers apart.
    "DEVHOST_ENGINEER": "${localEnv:DEVHOST_ENGINEER:operator}",
    // A tracking point for the month's agent spend at list price (dollars),
    // not a cap: the cost report and the briefing show it, nothing blocks.
    "DEVHOST_MONTHLY_TARGET": "200",
    // Ledger entries between reviews: 75 here, about one review a day at this
    // repository's entry rate (the Operator, ledger review 2026-10-21).
    "DEVHOST_REVIEW_EVERY": "75",
    // The workstation's machine name, set by the launcher (devcontainer-cli 1.16.2).
    "DCF_HOST_MACHINE": "${localEnv:DCF_HOST_MACHINE}",
    // 1 when DCF_HOST_FUSE=1 in .devcontainer/.env asked the launcher for FUSE
    "DCF_HOST_FUSE": "${localEnv:DCF_HOST_FUSE}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ],
      "settings": {
        "files.eol": "\n"
      }
    }
  }
}
