{
  "name": "devcontainer-features",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  // The devhost of this collection: everything `task lint`, `task test` and
  // `task docs` need, plus the collection's own Features so the host
  // session (Claude Code) works here the way every consuming repo does.
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {},
    // docker-in-docker rather than -outside-of-: `devcontainer features test`
    // bind-mounts paths from inside this container into the test containers,
    // which only a daemon sharing this filesystem can resolve. moby:false
    // because the base image is Debian 13 (no moby packages). On wslc (no
    // --privileged) the daemon does not start; the post-create report says so.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/shellcheck:1": {},
    "ghcr.io/devcontainers-extra/features/yamllint:2": {},
    // The collection's own Features by local path: `task features:stage`
    // copies src/<id> into .devcontainer/features/ (gitignored) before every
    // start (initializeCommand), so unreleased changes are what runs here.
    "./features/common": {},
    "./features/go-task": {},
    "./features/devcontainer-cli": {},
    "./features/git": {
      "hooksPath": ".githooks"
    },
    "./features/gh": {},
    "./features/claude-code": {}
  },
  // Host side, before every start: stage the Features, and check the git dir
  // that the checkout's .git pointer file names (kept outside OneDrive).
  "initializeCommand": {
    "features": ["task", "features:stage"],
    "git-dir": ["task", "devcontainer:homes", "NAME=devcontainer-features", "HOST_GIT_DIR=${localEnv:USERPROFILE}/.git-dirs/nabil-becker/devcontainer-features"]
  },
  // The checkout's .git is a pointer file holding a Windows path, so the real
  // git dir is bind-mounted and git is told where it is; the git Feature's
  // wrapper keeps that scoped to this checkout.
  "mounts": [
    "source=${localEnv:USERPROFILE}/.git-dirs/nabil-becker/devcontainer-features,target=/git/devcontainer-features.git,type=bind"
  ],
  "containerEnv": {
    "GIT_DIR": "/git/devcontainer-features.git",
    "GIT_WORK_TREE": "${containerWorkspaceFolder}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ],
      "settings": {
        "files.eol": "\n"
      }
    }
  }
}
